#
# Template for /etc/loom/secrets.env on the Loom host (root:loom 0640). See SETUP.md §3.4 and §9.2.
# This file holds NAMES ONLY. Never commit real values; they live on the host and in the board password manager.
# Format: NAME=value, one per line, no spaces or quotes around '='.

# Postgres DB role separation (OBI-130, D-27.4). Generate each on the
# host with `openssl rand -hex 24` (hex, so no URL escaping needed).
# Three distinct passwords, three distinct logins -- never reuse one
# across these:
#   - POSTGRES_SUPERUSER_PASSWORD: the Postgres superuser. Used only once,
#     by postgres/init/01-create-roles.sh, at first init of an empty
#     `pgdata` volume, to create the two logins below. Never appears in
#     DATABASE_URL or LOOM_DB_MIGRATE_URL.
#   - LOOM_OWNER_PASSWORD: `loom_owner`, owns the database and every
#     table/function; runs migrations (`docker compose run --rm migrate`)
#     and nightly backups (pg_dump). Never used by `loom serve`.
#   - LOOM_APP_PASSWORD: `loom_app`, the world-runtime login `loom serve`
#     connects with. Not an owner; no DDL rights (see
#     loom-persist/migrations/0001_init.sql for its exact grants).
POSTGRES_SUPERUSER_PASSWORD=
LOOM_OWNER_PASSWORD=
LOOM_APP_PASSWORD=

# GitHub fine-grained token for LoomMud/loom-gitops, Commit statuses: read+write (SETUP.md §8.1).
GITHUB_STATUS_TOKEN=

# Backups (Azure Blob, SETUP.md §6). Container-scoped SAS (rcwl, no delete); never the storage account key.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=loom-backups
AZURE_STORAGE_SAS_TOKEN=

# GHCR pull token (classic PAT, read:packages). Only if ghcr.io/loommud/loom cannot be public (SETUP.md §8.2).
#GHCR_TOKEN=
