#
# Template for /etc/loom/secrets.env on the Loom host (root:loom 0640). See SETUP.md §3.4 and §9.2.
# This file holds NAMES ONLY. Never commit real values; they live on the host and in the board password manager.
# Format: NAME=value, one per line, no spaces or quotes around '='.

# Postgres password: generate on the host with `openssl rand -hex 24` (hex, so no URL escaping needed).
POSTGRES_PASSWORD=

# GitHub fine-grained token for LoomMud/loom-gitops, Commit statuses: read+write (SETUP.md §8.1).
GITHUB_STATUS_TOKEN=

# Backups (Azure Blob, SETUP.md §6). Container-scoped SAS (rcwl, no delete); never the storage account key.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=loom-backups
AZURE_STORAGE_SAS_TOKEN=

# GHCR pull token (classic PAT, read:packages). Only if ghcr.io/loommud/loom cannot be public (SETUP.md §8.2).
#GHCR_TOKEN=
