#
# Single place for every image/ref pin used by staging/compose.yaml and
# staging/reconcile.sh (R6, OBI-42). There are no floating tags here:
# every image is pinned by digest, and the mudlib is pinned by commit SHA.
#
# To bump LOOM_IMAGE: merge a staging/bump-staging.yml PR (or edit by hand
# for support images) and let the reconciler pick it up on its next run.
# `docker compose --env-file staging/images.env -f staging/compose.yaml config`
# is a good local sanity check before committing a change here.

# --- Loom (bumped by .github/workflows/bump-staging.yml, D-P1.9) ---
# v0.1.0-alpha.3 (OBI-148/OBI-36 S2f): first release at/after loom#54
# (d4ba99e, boot program_flags fix) and loom#50 (888941a, roles snapshot
# from Postgres/LISTEN/audit sink). Required before WARP_REF can move to
# warp#9 (a50a002), which reads tiers only from the roles tables -- see
# the WARP_REF comment below and OBI-148 for the staff-row bootstrap that
# must land first.
# v0.1.0-alpha.2 (OBI-138/OBI-130/OBI-140): first release containing
# `loom migrate` (loom#51) and the ARC-runner buildx fix (loom#53).
# v0.1.0-alpha.1 was a failed tag with no published image -- do not use it.
# cosign-verified by reconcile.sh before every deploy (D-P1.8) against the
# LoomMud/loom release-image.yml OIDC identity; also verified in-workflow
# (run 36436622219) against the same identity before this digest was
# recorded here.
LOOM_IMAGE=ghcr.io/loommud/loom@sha256:53948750faa7be4e2413dc8fb7f3793a516921f0951f537349e9d164066ffcd5

# --- Mudlib (D-P1.11): mudlib-sync does a one-shot checkout of this ref
# into the `mudlib` volume, and resets the volume only when this value
# changes. A commit SHA, not a branch, so a reconcile is reproducible. ---
WARP_REPO=https://github.com/LoomMud/warp.git
# e34a3c2 (OBI-172): warp#14 character save/restore (needs loom 6b80019
# save_object/autosave, which alpha.6+ carries, and the `saves` volume,
# loom-gitops#37) + f43b60d (OBI-176, set_echo, alpha.6+). Earlier:
# 618b90c (OBI-155) reserved account names, e7dc458 (OBI-154).
WARP_REF=e34a3c22df583a6fc2960817bb27faac2dbe4a90

# --- Support images (manifest-list digests; multi-arch, so they don't need
# an amd64-specific pin). Bumped by hand in a reviewed PR, same as any
# other change in this repo -- there's no automation for these yet. ---
POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
CADDY_IMAGE=caddy:2-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
GIT_SYNC_IMAGE=alpine/git:v2.54.0@sha256:832b1cd1a271509f3d5272a1a62d4cb2ab1a53426ebde1f6c2cb7349f907dc6f

# Backup job base image (D-P1.12): loom's own runtime image has no
# pg_dump/age/rclone, so `backup` uses a plain Alpine base instead and
# installs those three packages from Alpine's own repos at container
# start (staging/backup.sh does `apk add --no-cache`). The base is still
# pinned by digest; only the three packages float with Alpine's own
# security updates, which is an accepted tradeoff for a job that runs
# once a night and is a no-op while backups are disabled (OBI-109).
#
# 3.22, not 3.20 (OBI-164): must carry postgresql17-client to match
# POSTGRES_IMAGE's major version below -- pg_dump refuses to dump a
# newer major server version, and 3.20's repos only carry
# postgresql16-client. Found by the OBI-164 CI restore drill (a real
# pg_dump against a real postgres:17-alpine), not by inspection; see
# staging/backup.sh's apk add line.
BACKUP_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

# Alerts job image (OBI-175/P2-O4 follow-up, CTO review on PR #34 item 2):
# unlike backup (once a night), loom-alerts.timer runs every minute, so
# installing curl+jq from Alpine's repos on every pass is a per-minute
# network dependency a transient CDN/DNS blip can turn into a total
# alerting blackout (set -e aborts the whole pass). This image bakes
# curl+jq into the layer instead; built, signed (cosign) and SBOM'd by
# .github/workflows/alerts-image.yml from staging/alerts/Dockerfile, and
# bumped here the same way that workflow bumps itself (an opened PR with
# the new digest). Placeholder until that workflow's first successful
# run on main publishes a real digest -- alerts.sh falls back to
# installing curl+jq itself (best-effort, non-fatal) if this image
# doesn't already have them, so staging alerting still works before this
# is bumped; see staging/alerts.sh's tool-check comment.
#
# Until then this is the digest-pinned BACKUP_IMAGE base, not the floating
# ghcr.io/loommud/loom-gitops-alerts:main tag: that tag does not exist
# before the workflow's first run, and the GHCR package is private by
# default (OBI-109), so a pull would fail and no check would run at all.
# The first alerts-image bump PR replaces this line with the real digest.
ALERTS_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

# --- Optional obs profile (Prometheus + Grafana), only pulled with
# `docker compose --profile obs up`. ---
PROMETHEUS_IMAGE=prom/prometheus:v3.6.0@sha256:76947e7ef22f8a698fc638f706685909be425dbe09bd7a2cd7aca849f79b5f64
GRAFANA_IMAGE=grafana/grafana:12.2.0@sha256:74144189b38447facf737dfd0f3906e42e0776212bf575dc3334c3609183adf7
