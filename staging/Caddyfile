# Caddyfile for the loom staging host (R6, OBI-42). Terminates TLS for the
# two public, Cloudflare-proxied names and reverse-proxies to the internal
# `loom` HTTP port, including WebSocket upgrades for the web client.
#
# system.loommud.com (SSH + telnet :4000) is never proxied here: Cloudflare
# can't carry SSH or raw TCP without Spectrum, so it's DNS-only straight to
# the host (SETUP.md §5.3). Only the two web-facing names below go through
# Caddy.

{
	# Real client IPs, for logs and any future rate limiting: Cloudflare
	# terminates the client connection and proxies to this origin, so
	# without trusted_proxies every request would appear to come from a
	# Cloudflare edge IP (SETUP.md Appendix A, R6-13).
	#
	# client_ip_headers: take the client IP from CF-Connecting-IP, which
	# Cloudflare always overwrites with the address it accepted the
	# connection from. Not X-Forwarded-For: Cloudflare *appends* to a
	# client-supplied XFF, so its leftmost entry is attacker-controlled.
	# Caddy only honours these headers when the TCP peer is inside
	# trusted_proxies; anything else resolves to the peer address.
	servers {
		client_ip_headers CF-Connecting-IP
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

loommud.com, www.loommud.com {
	# ACME HTTP-01 works through Cloudflare (Full strict, SETUP.md §5.2):
	# Cloudflare forwards :80 challenge requests to this origin. No DNS-01
	# credential is needed on the host.

	# /metrics stays internal (R6 acceptance criteria): never proxied to
	# players, whatever loom-http ends up exposing there.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# GitHub App webhook delivery for `propose` (D-B3.12, OBI-192/B3.5):
	# `loom-http` itself does the real validation (HMAC over
	# `/run/secrets/warp_webhook`, delivery dedupe, 1 MiB body cap, 30/min
	# rate limit). The `method POST` matcher is cosmetic, not a security
	# boundary (loom-gitops#36 review, S2): a stray GET to this same path
	# doesn't get rejected here -- it just falls through to the catch-all
	# `reverse_proxy` below, which also forwards to `loom:8080`, so
	# `loom-http` ends up 405-ing it either way. Kept anyway because it
	# documents intent and skips a matcher evaluation for the common case.
	@github-webhook {
		path /api/v1/hooks/github
		method POST
	}
	reverse_proxy @github-webhook loom:8080 {
		# Same as the catch-all below: loom-http's rate limiter and any
		# per-IP webhook accounting key off a consistent client IP.
		header_up X-Forwarded-For {remote_host}
	}

	# WebSocket upgrades (the web client's game connection) and everything
	# else go to loom's internal HTTP port. Caddy's reverse_proxy handles
	# the Upgrade/Connection headers for WSS automatically.
	reverse_proxy loom:8080 {
		# loom-http trusts X-Forwarded-For unconditionally for its login
		# rate limiter and auth audit_log (loom crates/loom-http/src/
		# client_ip.rs, OBI-200), which is only safe because :8080 is
		# reachable from this Caddy alone. Overwrite (never append) it with
		# the trusted_proxies-resolved client IP. {remote_host} would be the
		# Cloudflare edge IP and put every user behind one POP into the same
		# rate-limit bucket.
		header_up X-Forwarded-For {client_ip}
	}

	encode zstd gzip

	log {
		output stdout
		format json
	}
}

# Fallback: a Cloudflare Origin CA certificate instead of ACME (SETUP.md
# §5.2 fallback), only if HTTP-01 validation through Cloudflare can't be
# made to work. Uncomment and supply the cert/key paths (mounted read-only,
# never committed) instead of the automatic-TLS block above:
#
# loommud.com, www.loommud.com {
# 	tls /etc/caddy/origin-ca/loommud.com.pem /etc/caddy/origin-ca/loommud.com.key
# 	... (same reverse_proxy/metrics block as above)
# }
